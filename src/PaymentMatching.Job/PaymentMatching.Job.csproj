<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>payments-job</AssemblyName>
    <RootNamespace>PaymentMatching.Job</RootNamespace>
    <!-- Same id as the other tools, so one user-secrets store (id payment-matching-ai) serves all. -->
    <UserSecretsId>payment-matching-ai</UserSecretsId>
  </PropertyGroup>

  <!-- Image for the Azure Container Apps Job: dotnet publish /t:PublishContainer (ADR 0016). Chiseled = no shell,
       non-root; "extra" keeps ICU and time zone data. The registry and tag come from the deploy workflow. -->
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>payments-job</ContainerRepository>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaymentMatching.Data\PaymentMatching.Data.csproj" />
    <ProjectReference Include="..\PaymentMatching.Observability\PaymentMatching.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PaymentMatching.Job.Tests" />
  </ItemGroup>

</Project>
