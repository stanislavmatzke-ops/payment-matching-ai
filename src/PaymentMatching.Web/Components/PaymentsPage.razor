@* All payments of the sandbox: search, filters, sort and pages on the server (links and a GET form, no script). *@
<Shell Title="@T("Payments")" Page="Page" Active="payments">
    <div class="page-head">
        <div>
            <h1>@T("Payments")</h1>
            <p class="muted">@T("{0} of {1} payments", List.Matching, List.Total)</p>
        </div>
    </div>
    <form method="get" action="/payments" class="filter">
        <label>
            @T("Search")
            <input type="search" name="q" value="@List.Query.Search" maxlength="@PaymentQuery.MaxSearch" placeholder="@T("Payer, VS, message, amount or id")">
        </label>
        <label>
            @T("State")
            <select name="state">
                <option value="">@T("all")</option>
                @foreach (var state in PaymentState.All)
                {
                    <option value="@state" selected="@(state == List.Query.State)">@Format.State(state)</option>
                }
            </select>
        </label>
        <label>
            @T("Decided by")
            <select name="by">
                <option value="">@T("anyone")</option>
                @foreach (var by in PaymentQuery.Deciders)
                {
                    <option value="@by" selected="@(by == List.Query.By)">@Format.Decider(by)</option>
                }
            </select>
        </label>
        <input type="hidden" name="sort" value="@List.Query.Sort">
        <input type="hidden" name="dir" value="@(List.Query.Descending ? "desc" : "asc")">
        <button>@T("Show")</button>
        @if (List.Query.State is not null || List.Query.By is not null || List.Query.Search is not null)
        {
            <a class="button secondary" href="/payments">@T("Clear")</a>
        }
    </form>
    <section class="card">
        <p class="muted small">@T("Payer, VS and message are written by the payer and shown as plain text.")</p>
        <PaymentTable Items="List.Items" Query="List.Query" Empty="@T("No payments match.")" />
        @if (List.Pages > 1)
        {
            <nav class="pager" aria-label="@T("Pages")">
                @if (List.Page > 1)
                {
                    <a href="@List.Query.Url(page: List.Page - 1)">← @T("Previous")</a>
                }
                @for (var p = 1; p <= List.Pages; p++)
                {
                    var number = p;
                    if (number == List.Page)
                    {
                        <span class="current" aria-current="page">@number</span>
                    }
                    else
                    {
                        <a href="@List.Query.Url(page: number)">@number</a>
                    }
                }
                @if (List.Page < List.Pages)
                {
                    <a href="@List.Query.Url(page: List.Page + 1)">@T("Next") →</a>
                }
            </nav>
        }
    </section>
</Shell>

@code {
    [Parameter, EditorRequired]
    public PageContext Page { get; set; } = default!;

    [Parameter, EditorRequired]
    public PaymentListPage List { get; set; } = default!;
}
