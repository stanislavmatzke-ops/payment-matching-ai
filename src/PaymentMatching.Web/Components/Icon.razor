@* Small line icons drawn inline (no image requests, nothing for the CSP to allow). Colour comes from CSS (currentColor). *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "logo":
            <circle cx="8" cy="12" r="5" />
            <circle cx="16" cy="12" r="5" />
            <polyline points="13.5 12 15.5 14 19 9.5" />
            break;
        case "rule":
            <line x1="9" y1="6" x2="20" y2="6" />
            <line x1="9" y1="12" x2="20" y2="12" />
            <line x1="9" y1="18" x2="20" y2="18" />
            <polyline points="3.5 6 4.5 7 6.5 5" />
            <polyline points="3.5 12 4.5 13 6.5 11" />
            <polyline points="3.5 18 4.5 19 6.5 17" />
            break;
        case "ai":
            <path d="M12 3 L13.8 9.2 L20 11 L13.8 12.8 L12 19 L10.2 12.8 L4 11 L10.2 9.2 Z" />
            <path d="M19 15.5 L19.7 17.3 L21.5 18 L19.7 18.7 L19 20.5 L18.3 18.7 L16.5 18 L18.3 17.3 Z" />
            break;
        case "person":
            <circle cx="12" cy="8" r="4" />
            <path d="M4.5 20.5 C5.5 16.5 8.5 14.5 12 14.5 C15.5 14.5 18.5 16.5 19.5 20.5" />
            break;
        case "bank":
            <polyline points="3 9 12 4 21 9" />
            <line x1="5" y1="10" x2="5" y2="17" />
            <line x1="9.7" y1="10" x2="9.7" y2="17" />
            <line x1="14.3" y1="10" x2="14.3" y2="17" />
            <line x1="19" y1="10" x2="19" y2="17" />
            <line x1="3" y1="20" x2="21" y2="20" />
            break;
        case "check":
            <circle cx="12" cy="12" r="9" />
            <polyline points="7.5 12.5 10.5 15.5 16.5 9" />
            break;
        case "alert":
            <path d="M12 3.5 L21.5 20 L2.5 20 Z" />
            <line x1="12" y1="10" x2="12" y2="14" />
            <line x1="12" y1="17" x2="12" y2="17.2" />
            break;
        case "shield":
            <path d="M12 3 L19.5 6 V11.5 C19.5 16 16.3 19.5 12 21 C7.7 19.5 4.5 16 4.5 11.5 V6 Z" />
            <polyline points="8.5 12 11 14.5 15.5 9.5" />
            break;
        case "agent":
            <rect x="5" y="7" width="14" height="11" rx="3" />
            <line x1="12" y1="3.5" x2="12" y2="7" />
            <circle cx="9.5" cy="12.5" r="1" />
            <circle cx="14.5" cy="12.5" r="1" />
            break;
        case "cache":
            <path d="M5 12 A7 7 0 0 1 17.5 7.5" />
            <polyline points="18 3.5 18 7.8 13.8 7.8" />
            <path d="M19 12 A7 7 0 0 1 6.5 16.5" />
            <polyline points="6 20.5 6 16.2 10.2 16.2" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <polyline points="12 7 12 12 15.5 14" />
            break;
        case "queue":
            <rect x="4" y="4" width="16" height="5" rx="1.5" />
            <rect x="4" y="11" width="16" height="5" rx="1.5" />
            <line x1="6" y1="20" x2="18" y2="20" />
            break;
        case "chart":
            <line x1="4" y1="20" x2="20" y2="20" />
            <rect x="6" y="12" width="3" height="6" />
            <rect x="11" y="8" width="3" height="10" />
            <rect x="16" y="5" width="3" height="13" />
            break;
        case "list":
            <line x1="8" y1="7" x2="20" y2="7" />
            <line x1="8" y1="12" x2="20" y2="12" />
            <line x1="8" y1="17" x2="20" y2="17" />
            <circle cx="4.5" cy="7" r=".8" />
            <circle cx="4.5" cy="12" r=".8" />
            <circle cx="4.5" cy="17" r=".8" />
            break;
        case "eye":
            <path d="M2.5 12 C5 7.5 8.3 5.5 12 5.5 C15.7 5.5 19 7.5 21.5 12 C19 16.5 15.7 18.5 12 18.5 C8.3 18.5 5 16.5 2.5 12 Z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "arrow":
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="13 6 19 12 13 18" />
            break;
        default:
            <circle cx="12" cy="12" r="3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 16;

    [Parameter]
    public string? Class { get; set; }
}
