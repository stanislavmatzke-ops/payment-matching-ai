<Shell Title="@T("Privacy")">
    <h1>@T("Privacy")</h1>
    <p>@T("This is a demo application. All invoices and payments in it are synthetic.")</p>
    <h2>@T("What we keep")</h2>
    <ul>
        <li>@T("From your sign-in with Microsoft or Google: the provider, your account id at that provider (subject), your name and e-mail address. Nothing else; no access tokens are stored.")</li>
        <li>@T("Your sandbox: generated data and the decisions you or the application make in it.")</li>
    </ul>
    <h2>@T("Who sees it")</h2>
    <p>@T("Nobody else who signs in sees your sandbox. The operator of this application sees a list of accounts: your name, e-mail address, whether you signed in with Microsoft or Google, when your sandbox was created and last used, and how many payments you confirmed, rejected or matched by hand. The operator does not look into your sandbox's payments and invoices through this list.")</p>
    <h2>@T("Cookies")</h2>
    <p>@T("Only cookies needed to sign you in, to protect your forms and to remember your language: the sign-in session cookie, short-lived cookies used during the sign-in redirect, an anti-forgery cookie and, if you switch it, the language. No analytics, no advertising.")</p>
    <h2>@T("Deletion")</h2>
    <p>@T("A sandbox that nobody used for 30 days is deleted with everything in it, including your name and e-mail.")</p>
    <h2>AI</h2>
    <p>@T("You never send text to an AI model. A scheduled job processes only generated data.")</p>
    <h2>@T("Who runs this application")</h2>
    @if (Operator.Length > 0 || Contact.Length > 0)
    {
        <p>@T("The data controller is {0}.", Operator.Length > 0 ? Operator : T("the operator of this application"))</p>
        @if (Contact.Length > 0)
        {
            <p>
                @T("Contact:") <a href="mailto:@Contact">@Contact</a>. @T("Write to this address to see what is kept about you or to have your account and sandbox deleted right away; otherwise they are deleted after 30 days without use.")
            </p>
        }
    }
    else
    {
        <p class="muted">@T("The operator's contact is not configured") (<code>Operator:Name</code>, <code>Operator:Email</code>).</p>
    }
</Shell>

@code {
    /// <summary>The data controller (configuration <c>Operator:Name</c>).</summary>
    [Parameter]
    public string Operator { get; set; } = "";

    /// <summary>Where to ask about or delete your data (configuration <c>Operator:Email</c>).</summary>
    [Parameter]
    public string Contact { get; set; } = "";
}
