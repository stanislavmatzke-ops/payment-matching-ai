<Shell Title="@T("Payment {0}", Detail.Payment.Id)" Page="Page" Demo="Demo" Active="@(Demo ? null : "payments")">
    @if (Demo)
    {
        <p class="crumbs"><a href="/demo">← @T("Demo sandbox")</a> · <span class="muted">@T("read-only: sign in to decide payments in your own sandbox")</span></p>
    }
    else
    {
        <p class="crumbs"><a href="/queue">← @T("Queue")</a> · <a href="/payments">@T("All payments")</a></p>
    }
    <div class="page-head">
        <div>
            <h1>@T("Payment {0}", Detail.Payment.Id)</h1>
            <p class="muted">@T("Booked {0}", Format.Date(Detail.Payment.BookingDate))</p>
        </div>
        <div class="head-right">
            <span class="amount big">@Format.Amount(Detail.Payment.Amount, Detail.Payment.Currency)</span>
            <StateBadge State="@Detail.Payment.State" />
        </div>
    </div>
    <ResultNotice Result="Result" />

    <div class="detail-grid">
        <div class="detail-main">
            <section class="card">
                <h2 class="card-title"><Icon Name="bank" />@T("Bank statement line")</h2>
                <PaymentFacts Item="Detail.Payment" />
            </section>

            <section class="card decided">
                <h2 class="card-title"><Icon Name="check" />@T("Who decided")</h2>
                @if (Detail.Decision is { } d)
                {
                    @if (d.Layer == AuditRecord.AiLayer)
                    {
                        <div class="ai-banner">
                            <Icon Name="ai" Size="20" />
                            <div>
                                <strong>@T("Decided with AI")</strong>
                                <p>
                                    @T("The rules could not settle this payment")@(d.RuleCode is null ? "" : $" ({Format.Rule(d.RuleCode)})").
                                    @T("The model {0} read it and {1}; code checked the answer before anything was saved.", Model(d.DecidedBy), AiDid(d))
                                </p>
                            </div>
                        </div>
                    }
                    <div class="decider">
                        <DecidedByChip Value="@d.DecidedBy" />
                        <span>@Format.Status(d.Status)</span>
                    </div>
                    @if (d.Confidence is { } confidence)
                    {
                        <div class="meter-row">
                            <span>@T("Confidence")</span>
                            <strong>@confidence.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                        </div>
                        <Meter Value="confidence" Marker="MatchingOptions.Default.AutoMatchConfidence" Label="@T("Confidence")" Class="@(confidence >= MatchingOptions.Default.AutoMatchConfidence ? "good" : "low")" />
                        <p class="muted small">
                            @T("The line marks {0}: below it, or when a check fails, the payment comes to a person.", MatchingOptions.Default.AutoMatchConfidence.ToString("0.00", CultureInfo.InvariantCulture))
                        </p>
                    }
                    <dl class="facts">
                        <dt>@T("Layer")</dt><dd>@LayerText(d.Layer)</dd>
                        @if (d.RuleCode is not null)
                        {
                            <dt>@T("Rule")</dt><dd>@Format.Rule(d.RuleCode) <code class="muted small">@d.RuleCode</code></dd>
                        }
                        @if (d.PromptVersion is not null)
                        {
                            <dt>@T("Prompt")</dt><dd><code>@d.PromptVersion</code></dd>
                        }
                        @if (d.InvoiceNumbers.Count > 0)
                        {
                            <dt>@(d.Status == PaymentStatus.AutoMatched ? T("Matched to") : T("Proposed"))</dt><dd><strong>@string.Join(", ", d.InvoiceNumbers)</strong></dd>
                        }
                        @if (d.ValidationFailures.Count > 0)
                        {
                            <dt>@T("Validation")</dt><dd>@string.Join(", ", d.ValidationFailures)</dd>
                        }
                    </dl>
                    <blockquote class="reasoning untrusted">@d.Reason</blockquote>
                    <p class="muted small"><a href="/how">@T("How decisions are made")</a></p>
                    @if (Detail.CanUndoAi && !Demo)
                    {
                        <div class="actions">
                            <a class="button danger-outline" href="/payments/@Detail.Payment.Id/undo"><Icon Name="ai" />@T("Not right – undo the AI match…")</a>
                        </div>
                    }
                }
                else
                {
                    <p class="muted"><Icon Name="clock" /> @T("Not processed yet: this payment needs the AI layer and waits for the scheduled daily run.")</p>
                }
                @if (Detail.Review is { } r)
                {
                    <div class="decider person">
                        <DecidedByChip Value="@("person: " + r.DecidedBy)" />
                        <span>@Format.Time(r.At): @SandboxQueries.ActionText(r.Action)</span>
                    </div>
                    <dl class="facts">
                        @if (r.InvoiceNumbers.Count > 0)
                        {
                            <dt>@T("Invoices")</dt><dd>@string.Join(", ", r.InvoiceNumbers)</dd>
                        }
                        @if (r.Acknowledged.Count > 0)
                        {
                            <dt>@T("Accepted warnings")</dt><dd>@string.Join(", ", r.Acknowledged)</dd>
                        }
                    </dl>
                }
            </section>

            @if (Detail.Invoices.Count > 0)
            {
                <section class="card">
                    <h2 class="card-title"><Icon Name="list" />@T("Invoices")</h2>
                    <div class="table-wrap">
                        <table class="data compact">
                            <thead><tr><th>@T("Invoice")</th><th>@T("Kind")</th><th>VS</th><th>@T("Customer")</th><th>@T("Due")</th><th class="num">@T("Amount")</th><th>@T("State")</th></tr></thead>
                            <tbody>
                                @foreach (var invoice in Detail.Invoices)
                                {
                                    <tr>
                                        <td><strong>@invoice.Number</strong></td>
                                        <td>@(invoice.Kind == "Advance" ? T("advance") : T("invoice"))</td>
                                        <td>@invoice.VariableSymbol</td>
                                        <td>@invoice.CustomerName <span class="muted">(@invoice.CustomerId)</span></td>
                                        <td>@Format.Date(invoice.DueDate)</td>
                                        <td class="num">@Format.Amount(invoice.Amount, invoice.Currency)</td>
                                        <td>
                                            @if (invoice.MatchedToPayment is null)
                                            {
                                                <span class="muted">@T("open")</span>
                                            }
                                            else if (invoice.MatchedToPayment == Detail.Payment.Id)
                                            {
                                                <span>@T("matched to this payment")</span>
                                            }
                                            else
                                            {
                                                <span>@T("matched to {0}", invoice.MatchedToPayment)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ul class="comparisons">
                        @foreach (var c in Detail.Comparisons)
                        {
                            <li>
                                @T("Payment {0} against", Format.Amount(Detail.Payment.Amount, Detail.Payment.Currency))
                                <strong>@string.Join(" + ", c.InvoiceNumbers)</strong> (@Format.Amount(c.Total, c.Currency)):
                                @if (c.Difference is not { } difference)
                                {
                                    <span class="muted">@T("different currency, compared at the exchange rate by the checks")</span>
                                }
                                else if (difference == 0)
                                {
                                    <strong class="ok-text">@T("exact amount")</strong>
                                }
                                else
                                {
                                    <strong class="warn-text">@(difference > 0 ? "+" : "−")@Format.Amount(Math.Abs(difference), Detail.Payment.Currency)</strong>
                                    <span class="muted">@(difference > 0 ? T("paid more than invoiced") : T("paid less than invoiced"))</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (Detail.Actionable)
            {
                <section class="card decide">
                    <h2 class="card-title"><Icon Name="person" />@T("Your decision")</h2>
                    @if (Detail.Queue.Count == 0)
                    {
                        <p class="muted">@T("Nobody proposed a match. Match it manually or reject it.")</p>
                    }
                    @foreach (var proposal in Detail.Queue)
                    {
                        var warnings = proposal.Checks.Where(c => !ProposalChecks.Blocking.Contains(c)).ToList();
                        var blocked = proposal.Checks.Any(ProposalChecks.Blocking.Contains);
                        <div class="proposal">
                            <h3>@T("Proposal: {0}", string.Join(" + ", proposal.InvoiceNumbers))</h3>
                            <ul class="sources">
                                @foreach (var source in proposal.Sources)
                                {
                                    <li>
                                        <DecidedByChip Value="@source.ProposedBy" />
                                        <span class="muted">@T("Proposed by") <strong>@source.ProposedBy</strong></span>
                                        @if (source.Confidence is { } c)
                                        {
                                            <span class="muted">, @T("confidence") @c.ToString("0.00", CultureInfo.InvariantCulture)</span>
                                        }
                                        @if (source.PromptVersion is not null)
                                        {
                                            <span class="muted">, @T("prompt") @source.PromptVersion</span>
                                        }
                                        <div class="untrusted reason">@(source.ByAgent ? T("Agent's reason (untrusted): ") : T("Reasoning: "))@source.Reason</div>
                                    </li>
                                }
                            </ul>
                            <CheckList Failures="proposal.Checks" />
                            @if (!blocked)
                            {
                                <form method="post" action="/payments/@Detail.Payment.Id/confirm">
                                    <AntiforgeryField Field="Page!.Form" />
                                    <input type="hidden" name="proposal" value="@proposal.Id">
                                    <AcknowledgeFields Warnings="warnings" />
                                    <button class="primary"><Icon Name="check" />@T("Confirm")</button>
                                </form>
                            }
                        </div>
                    }
                    <div class="actions">
                        <a class="button secondary" href="/payments/@Detail.Payment.Id/match">@T("Match manually…")</a>
                        <form method="post" action="/payments/@Detail.Payment.Id/reject" class="inline">
                            <AntiforgeryField Field="Page!.Form" />
                            <button class="danger-outline">@T("Reject (do not match)")</button>
                        </form>
                    </div>
                </section>
            }
        </div>

        <aside class="card timeline-card">
            <h2 class="card-title"><Icon Name="clock" />@T("Audit trail")</h2>
            <ol class="timeline">
                @foreach (var e in Detail.Timeline)
                {
                    <li class="tl tl-@e.Kind">
                        <span class="tl-dot"><Icon Name="@TimelineIcon(e)" Size="14" /></span>
                        <div class="tl-body">
                            <div class="tl-head"><strong>@e.Actor</strong><span class="when">@Format.Time(e.At)</span></div>
                            <div>@e.Summary</div>
                            @if (e.InvoiceNumbers.Count > 0)
                            {
                                <div class="muted small">@T("Invoices: {0}.", string.Join(", ", e.InvoiceNumbers))</div>
                            }
                            @if (e.Details.Count > 0)
                            {
                                <ul class="tl-details">
                                    @foreach (var detail in e.Details)
                                    {
                                        <li class="untrusted">@detail</li>
                                    }
                                </ul>
                            }
                        </div>
                    </li>
                }
            </ol>
        </aside>
    </div>
</Shell>

@code {
    /// <summary>The signed-in person; null in the read-only demo.</summary>
    [Parameter]
    public PageContext? Page { get; set; }

    [Parameter]
    public bool Demo { get; set; }

    [Parameter, EditorRequired]
    public PaymentDetailView Detail { get; set; } = default!;

    [Parameter]
    public ReviewOutcome? Result { get; set; }

    private static string Model(string decidedBy) => decidedBy.StartsWith("ai:", StringComparison.Ordinal) ? decidedBy[3..] : decidedBy;

    private static string AiDid(PaymentDecisionView d) => d.Status switch
    {
        PaymentStatus.AutoMatched => T("matched it to {0} on its own", string.Join(" + ", d.InvoiceNumbers)),
        PaymentStatus.HumanReview when d.InvoiceNumbers.Count > 0 => T("proposed {0} to a person", string.Join(" + ", d.InvoiceNumbers)),
        _ => T("found no invoice it could stand behind"),
    };

    private static string LayerText(string layer) => layer switch
    {
        AuditRecord.RuleLayer => T("rules (ported from the legacy system)"),
        AuditRecord.AiLayer => T("AI model, checked by code"),
        _ => T("policy (no model needed)"),
    };

    private static string TimelineIcon(TimelineEvent e) => e.Kind switch
    {
        TimelineKind.Received => "bank",
        TimelineKind.ModelCall => e.Icon,
        TimelineKind.Proposed => "agent",
        TimelineKind.Reviewed => "person",
        _ => e.Actor.StartsWith("rule:", StringComparison.Ordinal) ? "rule" : e.Actor.StartsWith("ai:", StringComparison.Ordinal) ? "ai" : "shield",
    };
}
