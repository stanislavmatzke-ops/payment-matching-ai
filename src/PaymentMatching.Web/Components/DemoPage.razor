@* The public read-only demo (SPEC 9b): a shared sandbox processed by the daily job. No forms, no actions. *@
<Shell Title="@T("Demo")" Demo="true">
    <div class="page-head">
        <div>
            <h1>@T("Demo sandbox (read-only)")</h1>
            <p class="muted">
                @T("A fictional company with invoices and bank payments (synthetic data, Demo Bank). Every morning a scheduled job adds a few new payments and runs rules → AI → validation by code over them.")
                <a href="/">@T("Sign in")</a> @T("to get your own sandbox, where you confirm, reject or match payments yourself.")
            </p>
        </div>
    </div>

    <section class="hero-grid">
        <div class="card ring-card">
            <Ring Value="Board.AutomationRate" Text="@Format.Percent(Board.AutomationRate)" Label="@T("Automation rate")" Size="132" />
            <div>
                <h2 class="card-title">@T("Automation")</h2>
                <p>@T("{0} of {1} processed payments matched without a person.", Board.AutoMatched, Board.Processed)</p>
                <p class="muted small">@T("Open any payment to see who decided it and the full audit trail.")</p>
            </div>
        </div>
        <AiAddedCard Board="Board" Demo="true" />
    </section>

    <section class="card">
        <h2 class="card-title"><Icon Name="list" />@T("Payments")</h2>
        <p class="muted small">@T("Payer, VS and message are written by the payer and shown as plain text.")</p>
        <PaymentTable Items="Items" LinkBase="/demo/payments" Empty="@T("No payments yet: the daily run fills the demo.")" />
    </section>
</Shell>

@code {
    [Parameter, EditorRequired]
    public DashboardView Board { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<PaymentListItem> Items { get; set; } = [];
}
