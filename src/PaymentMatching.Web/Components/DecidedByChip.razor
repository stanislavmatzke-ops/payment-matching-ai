@* Who decided a payment: a rule, a model, a person, an agent or the policy, as a chip with an icon. *@
@if (Value is null)
{
    <span class="chip chip-none"><Icon Name="clock" />@T("not yet")</span>
}
else
{
    <span class="chip chip-@Kind" title="@Tooltip"><Icon Name="@IconName" />@Label</span>
}

@code {
    [Parameter]
    public string? Value { get; set; }

    private string Kind => Value is null ? "none" : DecidedBy.KindOf(Value);

    private string Detail => Value is null ? "" : DecidedBy.Detail(Value);

    private string IconName => Kind is DecidedBy.PolicyKind ? "shield" : Kind;

    private string Label => Kind switch
    {
        DecidedBy.RuleKind => T("rule") + " " + Detail,
        DecidedBy.AiKind => Detail.Replace("claude-", "", StringComparison.Ordinal),
        DecidedBy.PersonKind => Detail.Length > 0 ? Detail : T("person"),
        DecidedBy.PolicyKind => T("policy"),
        _ => Value!,
    };

    /// <summary>For a rule, what the code means; otherwise the full value.</summary>
    private string? Tooltip => Kind == DecidedBy.RuleKind ? Format.Rule(Detail) : Value;
}
