@* The page frame. Static server rendering only: no scripts, no inline styles (the CSP forbids both). *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>@Title – Payment matching</title>
    <link rel="stylesheet" href="/app.css">
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="@(Demo ? "/demo" : "/")"><Icon Name="logo" Size="22" Class="brand-mark" /><span>Payment matching</span><span class="brand-tag">AI</span></a>
            @if (Demo)
            {
                <nav class="nav">
                    <a href="/demo" class="active"><Icon Name="eye" />Demo</a>
                </nav>
                <a class="button small" href="/">Sign in for your own sandbox</a>
            }
            else if (Page is not null)
            {
                <nav class="nav">
                    <a href="/" class="@(Active == "dashboard" ? "active" : null)"><Icon Name="chart" />Dashboard</a>
                    <a href="/queue" class="@(Active == "queue" ? "active" : null)">
                        <Icon Name="queue" />Queue
                        @if (Page.Waiting > 0)
                        {
                            <span class="count">@Page.Waiting</span>
                        }
                    </a>
                    <a href="/payments" class="@(Active == "payments" ? "active" : null)"><Icon Name="list" />Payments</a>
                    @if (Page.IsAdmin)
                    {
                        <a href="/admin" class="@(Active == "admin" ? "active" : null)"><Icon Name="shield" />Admin</a>
                    }
                </nav>
                <form method="post" action="/logout" class="user">
                    <AntiforgeryField Field="Page.Form" />
                    <span class="avatar" aria-hidden="true">@Initial</span>
                    <span class="user-name">@Page.UserName</span>
                    <button class="ghost small">Sign out</button>
                </form>
            }
        </div>
    </header>
    @if (Demo)
    {
        <div class="ribbon">
            <Icon Name="eye" /> <strong>Read-only demo.</strong> A shared sandbox, processed every morning by the scheduled job. Nothing here can be changed.
        </div>
    }
    <main>
        @ChildContent
    </main>
    <footer>
        <span><Icon Name="shield" /> Synthetic data only (fictional Demo Bank). Visitors never start a model.</span>
        <a href="/privacy">Privacy</a>
    </footer>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The signed-in person; null on public pages.</summary>
    [Parameter]
    public PageContext? Page { get; set; }

    /// <summary>The public read-only demo: its own navigation, no forms.</summary>
    [Parameter]
    public bool Demo { get; set; }

    /// <summary>Highlighted navigation item: dashboard, queue, payments or admin.</summary>
    [Parameter]
    public string? Active { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Initial => Page?.UserName is { Length: > 0 } name ? char.ToUpperInvariant(name[0]).ToString() : "?";
}
