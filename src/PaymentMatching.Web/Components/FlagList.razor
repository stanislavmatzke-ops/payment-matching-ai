@* Risk signals of a payment. Prompt injection stands out; the budget label is set by code, never by a model. *@
@if (Item.InjectionSuspected || Item.Flags.Any(f => f != Flags.PromptInjection))
{
    <div class="flags">
        @if (Item.InjectionSuspected)
        {
            <span class="flag danger"><Icon Name="alert" Size="12" />@T("prompt injection?")</span>
        }
        @foreach (var flag in Item.Flags.Where(f => f != Flags.PromptInjection))
        {
            <span class="flag@(flag == Flags.AiBudgetUsedUp ? " warn" : "")">@Format.Flag(flag)</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public PaymentListItem Item { get; set; } = default!;
}
