@* One payment in a table. Payer, VS and message come from the bank statement: untrusted, shown as text only. *@
<tr class="@(Item.InjectionSuspected ? "row-danger" : null)">
    <td><a href="@LinkBase/@Item.Id" class="pay-id">@Item.Id</a></td>
    <td class="nowrap muted">@Format.Date(Item.BookingDate)</td>
    <td class="num">@Format.Amount(Item.Amount, Item.Currency)</td>
    <td class="untrusted">@Item.CounterpartyName</td>
    <td class="untrusted mono">@Item.VariableSymbol</td>
    <td class="untrusted message">@Item.Message</td>
    <td><StateBadge State="@Item.State" /></td>
    <td><DecidedByChip Value="@Item.DecidedBy" /></td>
    <td><FlagList Item="Item" /></td>
</tr>

@code {
    [Parameter, EditorRequired]
    public PaymentListItem Item { get; set; } = default!;

    /// <summary>Where payment links point: /payments for the signed-in person, /demo/payments in the demo.</summary>
    [Parameter]
    public string LinkBase { get; set; } = "/payments";
}
