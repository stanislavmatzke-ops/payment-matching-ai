<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="AI">
    <!-- Official Anthropic C# SDK: structured output, typed errors, retries and timeouts (ADR 0005). -->
    <PackageVersion Include="Anthropic" Version="13.8.0" />
  </ItemGroup>
  <ItemGroup Label="MCP">
    <!-- Official C# MCP SDK: server, stdio and Streamable HTTP transports (ADR 0010). -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <!-- EF Core on PostgreSQL: tenant query filters and unique indexes in the data layer (ADR 0011). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design time only (dotnet ef migrations); never shipped. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <!-- One standard OpenID Connect handler for both Microsoft and Google sign-in (ADR 0011). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Configuration">
    <!-- Match.Cli only: read the API key from dotnet user-secrets or the environment. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- A real PostgreSQL per test run: unique indexes and query filters behave as in production. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- In-memory host for HTTP tests of the web app. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
  </ItemGroup>
</Project>
