# Copy to .env for local development. Never commit .env.
# Real secrets belong in user-secrets, environment variables or Azure Key Vault.

# PostgreSQL (docker compose)
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432

# Web app and MCP server (--tenant). Locally the web app reads appsettings.Development.json.
ConnectionStrings__Payments=

# Sign-in (phase 7). Leave empty to disable a provider; locally prefer:
#   dotnet user-secrets set "Auth:Microsoft:ClientId" "<id>" --id payment-matching-ai
Auth__Microsoft__ClientId=
Auth__Microsoft__ClientSecret=
Auth__Google__ClientId=
Auth__Google__ClientSecret=

# Daily job and hosted app (phase 9). Demo: any GUID; the job creates the read-only demo sandbox.
Demo__TenantId=
# /admin: allow-listed accounts as provider:subject (e.g. google:1234567890)
Admin__Accounts__0=
# AI budgets (defaults: 20 calls per sandbox and day, 50 per day, $2 a month)
Ai__Budget__CallsPerSandboxPerDay=
Ai__Budget__CallsPerDay=
Ai__Budget__MonthlyUsd=
Ai__SmallModelOnly=

# Telemetry (phase 10, ADR 0015). Empty = nothing is exported.
#   local: docker compose --profile observability up -d, then OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#   Azure (phase 11): set by infra/main.bicep from the Application Insights resource
OTEL_EXPORTER_OTLP_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# AI providers (used from phase 4; leave empty – tests and evals run in replay mode without keys)
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
