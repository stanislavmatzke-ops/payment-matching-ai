# Copy to .env for local development. Never commit .env.
# Real secrets belong in user-secrets, environment variables or Azure Key Vault.

# PostgreSQL (docker compose)
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432

# AI providers (used from phase 4; leave empty – tests and evals run in replay mode without keys)
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
